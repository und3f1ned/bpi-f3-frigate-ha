#!/bin/sh
# Disables NVMe power saving on the BPI-F3 (SpacemiT K1): the drive's APST and the PCIe link's ASPM L1.
# Without this the NVMe controller (tested with a Patriot P300) can hang:
#   "nvme nvme0: I/O tag ... QID 0 timeout, disable controller".
# The kernel parameters pcie_aspm=off / nvme_core.default_ps_max_latency_us=0 break booting on the
# current-spacemit kernel, so this is set at runtime. Run by 60-k1-nvme-tune.rules (udev) whenever an
# NVMe disk appears; safe to run by hand at any time.
for c in /sys/class/nvme/nvme*; do
  [ -e "$c" ] || continue
  # 0 => the driver disables APST (Autonomous Power State Transition)
  [ -w "$c/power/pm_qos_latency_tolerance_us" ] && echo 0 > "$c/power/pm_qos_latency_tolerance_us"
  pci=$(readlink -f "$c/device")
  [ -w "$pci/link/l1_aspm" ] && echo 0 > "$pci/link/l1_aspm"
  msg="$(basename "$c"): APST and ASPM L1 disabled"
  echo "$msg"
  command -v logger >/dev/null && logger -t k1-nvme-tune "$msg"
done
exit 0
